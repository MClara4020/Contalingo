# Defina estas variáveis no ambiente do processo (ou com o gerenciador da hospedagem).
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/contalingo.sqlite
# Em produção, use a origem pública HTTPS exata, sem barra final.
APP_ORIGIN=https://contalingo.exemplo.com

# Turso/libSQL. Configure como variáveis de servidor, sem prefixo VITE_.
TURSO_DATABASE_URL=libsql://seu-banco-sua-organizacao.turso.io
TURSO_AUTH_TOKEN=seu-token-do-banco

# PostgreSQL (por exemplo, Neon). Quando configurada, tem precedência sobre Turso.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
